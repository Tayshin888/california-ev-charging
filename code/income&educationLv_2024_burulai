```{python}
from pathlib import Path
import geopandas as gpd
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd

DATA_DIR = Path("Data")

vehicles = pd.read_excel(
    DATA_DIR / "2023-2024 EVs.xlsx")
edu_2024 = pd.read_excel(
    DATA_DIR / "2024 edu.xlsx",
    sheet_name="Data",
    header=None)
income_2024 = pd.read_excel(
    DATA_DIR / "2024 median income.xlsx",
    sheet_name="Data",
    header=None)
population_2024 = pd.read_excel(
    DATA_DIR / "Population 2024.xlsx",
    sheet_name="Data",
    header=None)
#------------------------------
```
```{python}
#-----------SOLUTION-----------
vehicles_2024 = vehicles[
    vehicles["Data Year"] == 2024]

ev_2024 = (vehicles_2024.groupby("County", as_index=False)["Number of Vehicles"].sum())
#------------------------------
```
```{python}
#-----------SOLUTION-----------
education_data = []

for col in range(len(edu_2024.columns)):
    county = edu_2024.iloc[0, col]

    if isinstance(county, str) and "County, California" in county:
        county_name = county.replace(" County, California", "")

        education = edu_2024.iloc[18, col + 2]
        education = float(education.replace("%", ""))

        education_data.append(
            [county_name, education])

education_df = pd.DataFrame(
    education_data,
    columns=["County", "education_pct"])

#------------------------------
```
```{python}
#-----------SOLUTION-----------
income_data = []

for col in range(len(income_2024.columns)):
    county = income_2024.iloc[0, col]

    if isinstance(county, str) and "County, California" in county:
        county_name = county.replace(" County, California", "")

        income = income_2024.iloc[4, col + 4]
        income = float(str(income).replace(",", ""))

        income_data.append(
            [county_name, income])

income_df = pd.DataFrame(
    income_data,
    columns=["County", "median_income"])


#------------------------------
```
```{python}
#-----------SOLUTION-----------
population_data = []

for col in range(len(population_2024.columns)):
    county = population_2024.iloc[0, col]

    if isinstance(county, str) and "County, California" in county:
        county_name = county.replace(" County, California", "")

        population = population_2024.iloc[2, col]
        population = float(str(population).replace(",", ""))

        population_data.append(
            [county_name, population])

population_df = pd.DataFrame(
    population_data,
    columns=["County", "population"])

#------------------------------
```
```{python}
#-----------SOLUTION-----------
data = ev_2024.merge(
    education_df,
    on="County",
    how="inner")

data = data.merge(
    income_df,
    on="County",
    how="inner")

data = data.merge(
    population_df,
    on="County",
    how="inner")
#------------------------------
```
```{python}
#-----------SOLUTION-----------
data["vehicles_per_1000"] = (
    data["Number of Vehicles"]
    / data["population"]
    * 1000)
#------------------------------
```
```{python}
#-----------SOLUTION-----------
fig, axes = plt.subplots(1, 2, figsize=(12, 5))
axes[0].scatter(
    data["education_pct"],
    data["vehicles_per_1000"],
    alpha=0.6)

axes[0].set_title(
    "Education and plug-in vehicle adoption, 2024")
axes[0].set_xlabel(
    "Bachelor's degree or higher (%)")
axes[0].set_ylabel(
    "Plug-in vehicles per 1,000 people")
axes[1].scatter(
    data["median_income"],
    data["vehicles_per_1000"],
    alpha=0.6)
axes[1].set_title(
    "Income and plug-in vehicle adoption, 2024")
axes[1].set_xlabel(
    "Median household income ($)")
axes[1].set_ylabel(
    "Plug-in vehicles per 1,000 people")
plt.tight_layout(rect=[0, 0.07, 1, 1])

fig.text(
    0.01,
    0.02,
    "Source: U.S. Census Bureau ACS and California vehicle registration data.",
